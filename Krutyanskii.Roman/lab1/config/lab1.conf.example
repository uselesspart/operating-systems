# Configuration file of the lab1 daemon (variant 14).
#
# Format: one rule per line, "folder ignfile [seconds]".
# The content of "folder" is cleared whenever "ignfile" is missing from that
# folder. If the guard file is present, the folder is left untouched.
#
# The optional third field is the interval for this rule in seconds; without it
# the default of 20 seconds (fixed by variant 14) is used. The daemon wakes up
# every min(interval) and runs a rule once its own interval has passed.
#
# Empty lines and lines starting with '#' are ignored. Every other line must
# contain two or three fields.

# cleared only while /tmp/lab1-scratch/dont.erase is absent
/tmp/lab1-scratch dont.erase

# cleared only while /tmp/lab1-reports/keep.txt is absent
/tmp/lab1-reports keep.txt

# the same, but checked every 5 seconds instead of every 20
/tmp/lab1-fast dont.erase 5
