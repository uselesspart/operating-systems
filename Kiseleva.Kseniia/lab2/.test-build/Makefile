	$(MAKE) $(MAKESILENT) -f CMakeFiles/host_fifo.dir/build.make CMakeFiles/host_fifo.dir/host.cpp.i
	$(MAKE) $(MAKESILENT) -f CMakeFiles/host_mq.dir/build.make CMakeFiles/host_mq.dir/host.cpp.i
	$(MAKE) $(MAKESILENT) -f CMakeFiles/host_sock.dir/build.make CMakeFiles/host_sock.dir/host.cpp.i
.PHONY : host.cpp.i

host.s: host.cpp.s
.PHONY : host.s

# target to generate assembly for a file
host.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/host_fifo.dir/build.make CMakeFiles/host_fifo.dir/host.cpp.s
	$(MAKE) $(MAKESILENT) -f CMakeFiles/host_mq.dir/build.make CMakeFiles/host_mq.dir/host.cpp.s
	$(MAKE) $(MAKESILENT) -f CMakeFiles/host_sock.dir/build.make CMakeFiles/host_sock.dir/host.cpp.s
.PHONY : host.cpp.s

