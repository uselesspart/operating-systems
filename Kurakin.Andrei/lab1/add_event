#!/usr/bin/env bash
set -euo pipefail

usage() {
    echo "Usage: $0 YYYY-MM-DD HH:MM [-h|-d|-w] message text" >&2
    echo "  -h = hourly, -d = daily, -w = weekly; without flag = once" >&2
    exit 1
}

(( $# >= 3 )) || usage

event_date=$1
event_time=$2
shift 2

repeat=""
if [[ "${1:-}" =~ ^-(h|d|w)$ ]]; then
    repeat=$1
    shift
fi
(( $# >= 1 )) || usage
message="$*"

[[ $event_date =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || usage
[[ $event_time =~ ^[0-9]{2}:[0-9]{2}$ ]] || usage
[[ -n "${message//[[:space:]]/}" && ${#message} -le 4096 ]] || usage
[[ "$message" != *$'\n'* && "$message" != *$'\r'* ]] || usage

# Отбрасываем несуществующие даты, например 30 февраля.
normalized=$(date -d "$event_date $event_time" '+%Y-%m-%d %H:%M' 2>/dev/null) || {
    echo "Invalid date/time: $event_date $event_time" >&2
    exit 1
}
if [[ "$normalized" != "$event_date $event_time" ]]; then
    echo "Invalid date/time: $event_date $event_time" >&2
    exit 1
fi

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
config_file=${REMINDER_CONFIG:-"$script_dir/config.conf"}
if [[ ! -f "$config_file" ]]; then
    echo "Configuration file does not exist: $config_file" >&2
    exit 1
fi
config_file=$(realpath -- "$config_file")

# Демон читает конфиг под общей блокировкой.
# Здесь берём эксклюзивную блокировку, чтобы строка не записалась наполовину.
exec 9>>"$config_file"
flock -x 9
if [[ "$message" == "-h"* || "$message" == "-d"* || "$message" == "-w"* ]]; then
    # Сам текст тоже может начинаться со слова, похожего на флаг повтора.
    [[ -n "$repeat" ]] || repeat="--"
fi
printf 'event %s %s %s\n' "$event_date" "$event_time" "${repeat:+$repeat }$message" >&9
flock -u 9
exec 9>&-

echo "Event added: $event_date $event_time ${repeat:+$repeat }$message"

# После SIGHUP процесс перечитывает конфиг, включая события, добавленные позже.
pid_file="$(dirname -- "$config_file")/reminder.pid"
if [[ -r "$pid_file" ]]; then
    read -r pid < "$pid_file" || true
    if [[ ${pid:-} =~ ^[1-9][0-9]*$ && -e "/proc/$pid/exe" ]]; then
        expected=$(readlink -f -- "$script_dir/reminder_daemon")
        actual=$(readlink -- "/proc/$pid/exe" 2>/dev/null || true)
        if [[ "$actual" == "$expected" || "$actual" == "$expected (deleted)" ]]; then
            kill -HUP "$pid" 2>/dev/null || true
            echo "SIGHUP sent to daemon PID $pid"
        fi
    fi
fi
