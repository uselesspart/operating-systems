/var/log/disk_monitor.log {
    daily
    rotate 14
    compress
    delaycompress
    missingok
    notifempty
    create 0640 syslog adm
    sharedscripts
    postrotate
        # rsyslog's omfile action normally reopens files after rotation; reload
        # is included for setups that keep the file descriptor open longer.
        if command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet rsyslog; then
            systemctl reload rsyslog >/dev/null 2>&1 || systemctl restart rsyslog >/dev/null 2>&1 || true
        elif command -v service >/dev/null 2>&1; then
            service rsyslog reload >/dev/null 2>&1 || service rsyslog restart >/dev/null 2>&1 || true
        fi
    endscript
}
