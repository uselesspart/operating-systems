#!/usr/bin/env bash
CONFIG="${REMINDER_CONFIG:-reminder.conf}"

if [ $# -lt 3 ] || ! [[ "$1 $2" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}\ [0-9]{2}:[0-9]{2}$ ]] || ! date -d "$1 $2" >/dev/null 2>&1; then
    echo "Usage: add_event YYYY-MM-DD HH:MM [-h|-d|-w] text" >&2
    exit 1
fi

echo "add_event $*" >> "$CONFIG"
kill -HUP "$(cat /tmp/reminder.pid 2>/dev/null)" 2>/dev/null
echo "Event added"
